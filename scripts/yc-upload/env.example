# Copy to env.local and fill in values:
#   copy scripts\yc-upload\env.example scripts\yc-upload\env.local
#
# Run:
#   node --env-file=scripts/yc-upload/env.local scripts/yc-upload/index.mjs

YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_BUCKET=

# S3-compatible endpoint (do not change unless using a custom gateway)
YC_ENDPOINT=https://storage.yandexcloud.net
YC_REGION=ru-central1

# Object key prefix inside the bucket (CDN path prefix)
YC_PREFIX=belarus

# Local photos
YC_SOURCE_DIR=D:\catalogarchivesgov\belarus

# Resume state (do not commit)
YC_STATE_FILE=scripts/yc-upload/.upload-state.json

# Parallel uploads (8–16 is a good start for ~3–4MB JPEGs)
YC_CONCURRENCY=8
YC_MAX_RETRIES=5

# Optional: public CDN or Object Storage base URL for summary output
# Examples:
#   https://<cdn-resource-id>.yandexcloud.net
#   https://storage.yandexcloud.net/<bucket>
YC_PUBLIC_BASE_URL=
